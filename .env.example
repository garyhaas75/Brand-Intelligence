# ─── Dashboard Auth ───────────────────────────────────────────────────────────
# Comma-separated list of user:password pairs for dashboard access
# Example: gary:secret123,sarah:pass456
DASHBOARD_USERS=gary:changeme,sarah:changeme

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Gmail API (Module 6 — inbox monitoring) ──────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost
GMAIL_REFRESH_TOKEN=
SIGNUP_EMAIL=

# ─── Google Search Console (Module 4 — SEO) ───────────────────────────────────
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=

# ─── Apify (Module 3 — site scraper for Cloudflare-protected sites) ───────────
APIFY_API_TOKEN=

# ─── Shopify Admin API (Phase 3 — push SEO suggestions to live store) ─────────
# Admin API token from Shopify Admin > Apps > Develop apps > your app > API credentials
# Required scopes: write_products, write_product_listings
SHOPIFY_STORE_DOMAIN=anneklein.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=2025-07

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
