# ─── Dashboard Auth ───────────────────────────────────────────────────────────
DASHBOARD_USERS=gary:changeme

# ─── Anthropic (REQUIRED) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Apify (OPTIONAL — bot-protected sites + Instagram) ──────────────────────
APIFY_API_TOKEN=

# ─── Instagram Login (OPTIONAL — needed for restricted/private accounts) ──────
# Add an Instagram account to allow scraping restricted profiles (e.g. @toysruslb)
IG_USERNAME=
IG_PASSWORD=

# ─── SerpAPI (OPTIONAL — real search rankings) ────────────────────────────────
SERP_API_KEY=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
BASE_URL=http://localhost:3001

# ─── Japan toys scan (all OPTIONAL, each degrades softly when unset) ──────────
# YouTube Data API v3: competitor channel stats and recent uploads
YOUTUBE_API_KEY=
# Rakuten Ichiba API app id: official ranking data (else page scraping is used)
RAKUTEN_APP_ID=
# e-Stat app id: Japan demographic baselines for personas
ESTAT_APP_ID=
# Perplexity: second AI agent in GEO visibility score
PERPLEXITY_API_KEY=
